{
  "workbench.colorTheme": "Dracula Theme",
  // Disable Copilot autocomplete globally
  "github.copilot.enable": {
    "*": false,
    "go": false
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#7cc06b",
